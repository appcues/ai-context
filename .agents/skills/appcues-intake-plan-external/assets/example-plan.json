  "summary": {
    "overview": "Brightwave wants to lift activation of its care-team scheduling feature and cut support tickets from new clinic admins. Web (React SPA) and a React Native app are in scope; a vendor chat assistant (Intercom Fin) sits in the web app. Salesforce is the system of record for accounts and lifecycle stage.",
    "headline_callout": {
      "title": "Settle first: which ID identifies a clinic?",
      "body": "Salesforce uses an 18-character Account ID; the product uses a numeric clinic_id. Pick one for account data and store it as a Text field in the other system."
    },
    "readiness": [
      {
        "area": "1. SDK initialized in every environment",
        "status": "yellow",
        "note": "Web and React Native in scope; CSP ticket needed for web."
      },
      {
        "area": "2. Users and accounts identified",
        "status": "yellow",
        "note": "User ID decided (internal UUID); account ID still open."
      },
      {
        "area": "3. Objectives mapped and defined",
        "status": "green",
        "note": "Two goals with owners and a baseline."
      },
      {
        "area": "4. Integration workstream established",
        "status": "red",
        "note": "No Salesforce admin named yet; Snowflake owner unknown."
      },
      {
        "area": "5. Data in use, not just collected",
        "status": "yellow",
        "note": "Every planned property has a use; 2 events still need a Dashboard owner."
      },
      {
        "area": "6. Key Moments measure what matters",
        "status": "yellow",
        "note": "'Scheduled First Shift' event does not exist yet - must ship with install."
      }
    ],
    "key_decisions": [
      {
        "decision": "User ID",
        "answer": "Internal user UUID",
        "why": "Can't be changed later without splitting every user's history. Must also live on the Salesforce Contact.",
        "owner": "Sam Lee"
      },
      {
        "decision": "Account (group) ID",
        "answer": "",
        "why": "Salesforce matches accounts on this value; it must be a Text field there.",
        "owner": ""
      },
      {
        "decision": "Install method",
        "answer": "NPM package",
        "why": "Switching to Segment or GTM later means redoing identify and track.",
        "owner": "Sam Lee"
      },
      {
        "decision": "Identity verification",
        "answer": "",
        "why": "Teams that skip this decision often meet it later as a security finding.",
        "owner": ""
      }
    ]
  },
